{
    "name": "xvba-app",
    "version": "1.0.0",
    "description": "A XVBA App",
    "main": "index.js",
    "scripts": {
        "workflow": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1",
        "version:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action StartVersion",
        "branch:create": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action CreateBranch",
        "branch:merge": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action MergeBranch",
        "version:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action Release",
        "version:cancel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action CancelVersion",
        "workflow:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action Status",
        "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action SecurityBuild",
        "release:code": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action SecurityCode",
        "release:config": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action SecurityConfig",
        "release:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action SecurityStatus",
        "release:sync-dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action SecuritySync",
        "release:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action SecurityValidate",
        "release:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./version-workflow.ps1 -Action SecurityAll",
        "test:workflow": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-version-workflow.ps1",
        "test:task-layout": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-task-layout.ps1",
        "test:completed-view": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-completed-task-view.ps1",
        "test:text-report": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-text-report.ps1",
        "test:web-payload": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-web-payload.ps1",
        "test:web-upload": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-web-upload.ps1",
        "test:web-transport": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-web-transport.ps1",
        "test:web-view": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-web-view.ps1",
        "test:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-refresh-performance.ps1",
        "test:hierarchy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-gantt-hierarchy.ps1",
        "test:release-security": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/test-release-security.ps1"
    },
    "author": "LocalSmart",
    "license": "ISC",
    "dependencies": {
        "excel-types": "1.0.0",
        "Xlog": "1.0.0"
    },
    "devDependencies": {
        "@localsmart/xvba-cli": "^1.0.2"
    }
}
